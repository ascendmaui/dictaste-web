{
  "name": "dictaste-universal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": ["sharp"],
    "overrides": {
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "fast-uri": "3.1.8",
      "serialize-javascript": "7.1.2",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "tar": "7.5.22",
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "cap:sync": "pnpm build && cap sync",
    "cap:ios": "pnpm cap:sync && cap open ios",
    "cap:android": "pnpm cap:sync && cap open android",
    "assets": "capacitor-assets generate"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.1",
    "@capacitor/preferences": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.2.8",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@capacitor/assets": "3.0.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.0.16"
  }
}
